/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU accelerator config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    VRAM-tiered labels so modules stay portable across GPU generations.
    Concrete per-hardware behaviour (device count, concurrency) lives in
    the hardware profiles in nextflow.config (e.g. p40_single, v100_multi).
----------------------------------------------------------------------------------------
*/

process {
    // Baseline GPU label — any module that needs a GPU at all.
    withLabel: process_gpu {
        accelerator = 1
    }

    // Generous time + memory + CPU requests for the Parabricks alignment.
    //
    //  - time: on a single Pascal P40, real WGS at 100x+ coverage can take
    //    12-16h for fq2bam alone, plus ~1-2h for the collate/fixmate/sort
    //    post-process. Volta+ finishes faster but the hint is harmless.
    //  - memory: fq2bam's internal `postsort` process accumulates unsorted
    //    reads in RAM as alignment progresses. On deep WGS this comfortably
    //    exceeds the 72 GB that `process_high` allocates and Docker's
    //    container cgroup will OOM-kill `postsort`, taking the whole job
    //    down (the error surfaces as a generic "Could not run fq2bam" with
    //    no CUDA trace — verify via `dmesg | grep -i oom` after a failure).
    //    128 GB is safe for ~100-150x deep tumor WGS; raise if you see the
    //    cgroup OOM symptom on even deeper input.
    //  - cpus: bumped from process_high's 12 to 16 so the samtools
    //    collate/fixmate/sort post-process scales.
    //
    // NOTE: these are *requests*. If the active profile's
    // process.resourceLimits caps any of them below these values, the cap
    // wins. The upstream `test` profile caps everything tightly; production
    // runs should pass a generous resourceLimits via -c (see README).
    withName: 'PARABRICKS_FQ2BAM' {
        time   = { 96.h    * task.attempt }
        memory = { 128.GB  * task.attempt }
        cpus   = { 16      * task.attempt }
    }

    // VRAM-tiered labels. Modules request the minimum VRAM they need; the
    // scheduler filters out nodes that don't satisfy it. Defaults here are
    // just the accelerator request; CPU/mem/time inherit from base.config
    // labels (process_high, etc.).
    withLabel: gpu_16gb {
        accelerator = 1
    }

    withLabel: gpu_24gb {
        accelerator = 1
    }

    withLabel: gpu_32gb {
        accelerator = 1
    }
}
