/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU accelerator config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    VRAM-tiered labels so modules stay portable across GPU generations.
    Concrete per-hardware behaviour (device count, concurrency) lives in
    the hardware profiles in nextflow.config (e.g. p40_single, v100_multi).
----------------------------------------------------------------------------------------
*/

process {
    // Baseline GPU label — any module that needs a GPU at all.
    withLabel: process_gpu {
        accelerator = 1
    }

    // Generous time hint for the Parabricks alignment step. On a single
    // Pascal P40, real WGS at 100x+ coverage can take 12-16h for fq2bam
    // alone, plus ~1-2h for the collate/fixmate/sort post-process. Volta
    // and newer cards will finish faster but the hint is harmless.
    //
    // NOTE: this is the per-process *request*. If the active profile sets
    // process.resourceLimits.time below this, that cap wins and the run
    // will be killed at the cap. The upstream `test` profile sets a 1h
    // cap; production runs should override resourceLimits via -c <config>
    // (see README "Resource caps and the test profile" section).
    withName: 'PARABRICKS_FQ2BAM' {
        time = { 96.h * task.attempt }
    }

    // VRAM-tiered labels. Modules request the minimum VRAM they need; the
    // scheduler filters out nodes that don't satisfy it. Defaults here are
    // just the accelerator request; CPU/mem/time inherit from base.config
    // labels (process_high, etc.).
    withLabel: gpu_16gb {
        accelerator = 1
    }

    withLabel: gpu_24gb {
        accelerator = 1
    }

    withLabel: gpu_32gb {
        accelerator = 1
    }
}
