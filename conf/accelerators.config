/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU accelerator config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    VRAM-tiered labels so modules stay portable across GPU generations.
    Concrete per-hardware behaviour (device count, concurrency) lives in
    the hardware profiles in nextflow.config (e.g. p40_single, v100_multi).
----------------------------------------------------------------------------------------
*/

process {
    // Baseline GPU label — any module that needs a GPU at all.
    withLabel: process_gpu {
        accelerator = 1
    }

    // VRAM-tiered labels. Modules request the minimum VRAM they need; the
    // scheduler filters out nodes that don't satisfy it. Defaults here are
    // just the accelerator request; CPU/mem/time inherit from base.config
    // labels (process_high, etc.).
    withLabel: gpu_16gb {
        accelerator = 1
    }

    withLabel: gpu_24gb {
        accelerator = 1
    }

    withLabel: gpu_32gb {
        accelerator = 1
    }
}
